;//////////////////////////////////////////////////////////////////////////////
;// Минимальный драйвер клавиатуры PS/2
;//////////////////////////////////////////////////////////////////////////////
;
;// Драйвер разбирает первый набор скан-кодов (set 1), который QEMU выдаёт
;// совместимому контроллеру i8042. Для учебного терминала поддерживаются
;// латинские буквы, цифры, пробел, Enter и Backspace. Модификаторы можно
;// добавить отдельной таблицей состояний, не меняя обработчик IRQ.

KEYBOARD.data_port = 0x60

keyboard_scancode_set1:
  db 0, 27, '1','2','3','4','5','6','7','8','9','0','-','=',8,9
  db 'q','w','e','r','t','y','u','i','o','p','[',']',10,0,'a','s'
  db 'd','f','g','h','j','k','l',';',39,'`',0,92,'z','x','c','v'
  db 'b','n','m',',','.','/',0,'*',0,' ',0,0,0,0,0,0
  times 128-($-keyboard_scancode_set1) db 0

;// Открыть IRQ1. Сам контроллер уже настроен BIOS.
keyboard_init:
  mov edi, 1
  call pic_unmask_irq
  ret

;// Прочитать один скан-код и, если это нажатие известной клавиши, вывести
;// соответствующий символ. Коды отпускания (старший бит = 1) игнорируются.
keyboard_on_irq:
  xor eax, eax
  in al, KEYBOARD.data_port
  test al, 0x80
  jnz .done
  cmp eax, 128
  jae .done
  lea rdx, [keyboard_scancode_set1]
  movzx edi, byte [rdx+rax]
  test edi, edi
  jz .done
  call print_char
  .done:
  ret
